# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (solo red interna de Docker en producción) ────────────────────
POSTGRES_USER=facturard
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=facturard
DATABASE_URL=postgresql://facturard:cambiar-en-produccion@localhost:5432/facturard
# Rol de aplicación sin BYPASSRLS (lo crea docker/initdb/01-app-role.sh)
POSTGRES_APP_PASSWORD=cambiar-en-produccion
# Si está definida, el API la usa para consultas tenant-scoped (RLS activa)
# APP_DATABASE_URL=postgresql://facturard_app:cambiar-en-produccion@localhost:5432/facturard

# ── Redis / BullMQ ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO (S3-compatible) ─────────────────────────────────────────────────────
MINIO_ROOT_USER=facturard
MINIO_ROOT_PASSWORD=cambiar-en-produccion
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=invoices
S3_REGION=us-east-1

# ── Claude API (extracción de facturas) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo con visión; mantener en env var, nunca hardcodear (ver especificación §5)
ANTHROPIC_MODEL=claude-fable-5
# Umbral de confianza para campos críticos (NCF, RNC, fecha, monto, ITBIS)
OCR_CONFIDENCE_THRESHOLD=0.90
OCR_MAX_RETRIES=3

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-en-produccion
JWT_REFRESH_EXPIRES_IN=7d

# ── Dominio (Caddy/TLS) ───────────────────────────────────────────────────────
APP_DOMAIN=localhost
# Base para enlaces generados (invitaciones, etc.)
APP_URL=http://localhost:3000
