# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (solo red interna de Docker en producción) ────────────────────
POSTGRES_USER=facturard
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=facturard
DATABASE_URL=postgresql://facturard:cambiar-en-produccion@localhost:5432/facturard
# Rol de aplicación sin BYPASSRLS (lo crea docker/initdb/01-app-role.sh)
POSTGRES_APP_PASSWORD=cambiar-en-produccion
# Si está definida, el API la usa para consultas tenant-scoped (RLS activa)
# APP_DATABASE_URL=postgresql://facturard_app:cambiar-en-produccion@localhost:5432/facturard

# ── Redis / BullMQ ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO (S3-compatible) ─────────────────────────────────────────────────────
MINIO_ROOT_USER=facturard
MINIO_ROOT_PASSWORD=cambiar-en-produccion
S3_ENDPOINT=http://localhost:9000
# Host público para las URL firmadas de imágenes (lo ve el navegador y el
# teléfono). En dev, ./scripts/dev.sh lo fija con la IP LAN de tu Mac.
# Para móvil manual: http://TU_IP_LAN:9000. En prod: https://tu-dominio (Caddy).
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=invoices
S3_REGION=us-east-1

# ── Claude API (extracción de facturas) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo con visión; mantener en env var, nunca hardcodear (ver especificación §5)
ANTHROPIC_MODEL=claude-haiku-4-5
# Umbral de confianza para campos críticos (NCF, RNC, fecha, monto, ITBIS)
OCR_CONFIDENCE_THRESHOLD=0.90
OCR_MAX_RETRIES=3
# Facturas procesadas en paralelo por worker
OCR_CONCURRENCY=3
# Verificación e-CF en vivo contra ecf.dgii.gov.do (Fase 4): sigue la URL del QR
# y confirma el estado oficial. Requiere salida a internet hacia la DGII.
#   1 = activado, vacío/0 = desactivado (por defecto se apoya solo en el padrón)
DGII_LIVE_VERIFICATION=
DGII_LIVE_TIMEOUT_MS=5000

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-en-produccion
JWT_REFRESH_EXPIRES_IN=7d

# ── Dominio (Caddy/TLS) ───────────────────────────────────────────────────────
APP_DOMAIN=localhost
# Base para enlaces generados (invitaciones, etc.) — en producción, https://APP_DOMAIN
APP_URL=http://localhost:3001
# Orígenes permitidos para CORS en desarrollo (panel Next.js local)
WEB_ORIGIN=http://localhost:3001
# URL del API vista desde el navegador en desarrollo (vacía en producción: mismo origen)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Correo transaccional (restablecer contraseña). Sin proveedor, el enlace se
# registra en el log del servidor (y se devuelve en dev). Para enviar de verdad,
# configura uno de estos (y conecta el proveedor en api/src/mail/mail.service.ts):
RESEND_API_KEY=
SMTP_URL=
