# TLS automático (Let's Encrypt) cuando APP_DOMAIN es un dominio real; en
# localhost Caddy usa su CA interna y no toca ACME.
{
	# Let's Encrypt avisa a este correo si un certificado deja de renovarse.
	# Sin él ese aviso se pierde y te enteras cuando el sitio ya está caído.
	email {$ACME_EMAIL:admin@localhost}
}

# El canónico va primero; el apex solo redirige. Así hay UNA sola URL buena:
# cookies, CORS y enlaces compartidos apuntan siempre al mismo sitio.
{$APP_DOMAIN:localhost}, {$APEX_DOMAIN:apex.localhost} {
	# subirfactura.com → www.subirfactura.com, conservando la ruta.
	@apex host {$APEX_DOMAIN:apex.localhost}
	redir @apex https://{$APP_DOMAIN:localhost}{uri} permanent

	encode gzip

	# HSTS (ESPECIFICACION.md §8)
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# API NestJS bajo /api; /health para monitoreo
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}

	# Panel web del contador (Next.js)
	handle {
		reverse_proxy web:3000
	}
}
