# TLS automático (Let's Encrypt) cuando los dominios son reales; en localhost
# Caddy usa su CA interna y no toca ACME.
{
	# Let's Encrypt avisa a este correo si un certificado deja de renovarse.
	# Sin él ese aviso se pierde y te enteras cuando el sitio ya está caído.
	email {$ACME_EMAIL:admin@localhost}

	servers {
		# Con Cloudflare delante, la conexión al origen viene de SU red: el API
		# vería la IP de Cloudflare y el rate-limit del login (10/min contra
		# fuerza bruta) metería a todo el mundo en el mismo cubo — o bloqueas a
		# inocentes, o el atacante se diluye entre el tráfico legítimo.
		#
		# Solo se confía en CF-Connecting-IP si el paquete VIENE de un rango de
		# Cloudflare; si no, esa cabecera la falsifica cualquiera y el rate-limit
		# se evade poniéndose una IP distinta en cada intento.
		#
		# Sin Cloudflare esto no hace nada: ningún cliente casa con los rangos y
		# {client_ip} cae en la IP real de la conexión. Por eso puede quedar
		# puesto desde antes de activarlo.
		#
		# Lista de rangos: https://www.cloudflare.com/ips (cambia muy de vez en
		# cuando; si algún día el rate-limit se comporta raro, revísala).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# El API corre con `trust proxy = 1`: espera UN salto. Con Cloudflare habría
# dos, así que aquí se reescribe X-Forwarded-For con la IP real ya resuelta y
# el API no necesita saber si hay CDN delante o no.
(alOrigen) {
	header_up X-Forwarded-For {client_ip}
}

# ── Panel (app.subirfactura.com) ──────────────────────────────────────────────
# Es el dominio CANÓNICO de la aplicación: los enlaces de los correos, las
# invitaciones y el CORS apuntan aquí. Las sesiones viven en localStorage, que
# es por origen, así que el panel tiene que estar siempre en el mismo host.
{$APP_DOMAIN:localhost} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# La raíz del panel no es la landing: al escritorio. 302 y no 301 — un 301
	# se cachea en el navegador para siempre y ata las manos si esto cambia.
	redir / /app

	handle /api/* {
		reverse_proxy api:3000 {
			import alOrigen
		}
	}
	handle /health {
		reverse_proxy api:3000 {
			import alOrigen
		}
	}
	handle {
		reverse_proxy web:3000 {
			import alOrigen
		}
	}
}

# ── Landing (www.subirfactura.com) ────────────────────────────────────────────
{$LANDING_DOMAIN:landing.localhost} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Las pantallas privadas viven SOLO en el panel: una URL por pantalla, y
	# nadie se queda mirando un /app en www preguntándose por qué salió la
	# sesión (localStorage no cruza de host).
	@panel path /app /app/* /orgs/* /admin /admin/* /settings /settings/* /onboarding /onboarding/* /login /register /forgot-password /reset-password /verificar-correo /invitations/*
	redir @panel https://{$APP_DOMAIN:localhost}{uri} permanent

	handle /health {
		reverse_proxy api:3000 {
			import alOrigen
		}
	}
	handle {
		reverse_proxy web:3000 {
			import alOrigen
		}
	}
}

# ── Apex (subirfactura.com) → landing ─────────────────────────────────────────
# Con APEX_DOMAIN vacío cae en un nombre .localhost que Caddy firma con su CA
# interna: no molesta a Let's Encrypt mientras el registro A no exista.
{$APEX_DOMAIN:apex.localhost} {
	redir https://{$LANDING_DOMAIN:landing.localhost}{uri} permanent
}
