// FacturaRD — esquema multi-tenant (ver ESPECIFICACION.md §4)
// Todo dato fiscal lleva organization_id; la RLS de PostgreSQL se activa en Fase 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  org_admin
  contador
  cliente
}

enum InvoiceStatus {
  subida
  procesando
  extraida
  en_revision
  validada
  incluida_en_606
  reportada
  rechazada
  duplicada
}

enum SubscriptionStatus {
  activa
  vencida
  suspendida
  cancelada
}

// Aprobación KYC de la empresa contadora (§7): el autoservicio nace pendiente,
// sube un documento que pruebe titularidad y el super-admin aprueba/rechaza.
enum OrgApprovalStatus {
  pendiente
  aprobada
  rechazada
}

// Política de aprobación de registros manuales A NIVEL DE CLIENTE:
// hereda el default de la empresa, o la fuerza/exime explícitamente.
enum ManualApprovalPolicy {
  heredar
  siempre
  nunca
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  // Opcional: un usuario que entra SOLO con Google/Facebook no tiene contraseña.
  // La identidad sigue siendo única por correo; los proveedores se enlazan en
  // oauth_accounts. Si es null, el login por contraseña se rechaza con un aviso.
  passwordHash String?      @map("password_hash")
  nombre       String
  telefono     String?
  isSuperAdmin Boolean      @default(false) @map("is_super_admin")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  clientProfiles ClientProfile[]
  clientMemberships ClientMember[]
  auditLogs    AuditLog[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  oauthAccounts OAuthAccount[]
  invitationsSent Invitation[]
  invoicesSubidas Invoice[]    @relation("InvoicesSubidas")

  @@map("users")
}

// Identidades de proveedor (Google, Facebook…) enlazadas a un User. Un mismo
// usuario (por correo) puede tener varias, y así "entrar con Google" y "entrar
// con Facebook" trabajan como la misma cuenta. providerAccountId es el id
// estable del usuario en el proveedor (el `sub` del ID token).
model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String // 'google' | 'facebook' | ...
  providerAccountId String   @map("provider_account_id")
  email             String?
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Refresh tokens rotados (ESPECIFICACION.md §8) — se guarda solo el hash
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// Tokens de restablecimiento de contraseña — se guarda solo el hash, con
// caducidad corta y un solo uso (usedAt). El valor en claro va al usuario.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

// Tokens de verificación de correo — mismo patrón que el reset: solo se guarda
// el hash, con un solo uso (usedAt). El valor en claro va en el enlace al usuario.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_verification_tokens")
}

// Invitaciones a una organización (rol contador o cliente)
model Invitation {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  email          String
  rol            MembershipRole
  // Para rol `cliente`: negocio al que queda vinculado al aceptar (se crea el
  // client_member automáticamente; antes era un 2.º paso oculto en "Gestionar").
  clientProfileId String?       @map("client_profile_id")
  tokenHash      String         @unique @map("token_hash")
  invitedById    String         @map("invited_by_id")
  expiresAt      DateTime       @map("expires_at")
  acceptedAt     DateTime?      @map("accepted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  invitedBy      User           @relation(fields: [invitedById], references: [id])
  clientProfile  ClientProfile? @relation(fields: [clientProfileId], references: [id])

  @@index([organizationId, email])
  @@map("invitations")
}

model Organization {
  id                 String              @id @default(uuid())
  nombre             String
  // Único cuando existe (Postgres permite varios NULL): dos despachos no
  // pueden compartir RNC.
  rnc                String?             @unique
  planId             String?             @map("plan_id")
  estadoSuscripcion  SubscriptionStatus? @map("estado_suscripcion")
  // Si está activo, la revisión exige que la aritmética (subtotal+impuestos=total)
  // cuadre antes de validar. El contador puede apagarlo por empresa.
  requiereValidacionAritmetica Boolean  @default(true) @map("requiere_validacion_aritmetica")
  // Default de la EMPRESA para el workflow de aprobación de registros manuales.
  // Los clientes lo heredan (o lo fuerzan/eximen con su propia política) y un
  // usuario de confianza puede quedar exento (Membership.exentoAprobacion).
  requiereAprobacionManual Boolean @default(false) @map("requiere_aprobacion_manual")
  // Logo de la empresa (objeto en MinIO); se muestra en la lista de empresas.
  logoKey            String?             @map("logo_key")
  // Borrado lógico (solo super-admin). Una org borrada desaparece para sus
  // miembros (guard y /me la filtran) pero sus datos fiscales se conservan.
  deletedAt          DateTime?           @map("deleted_at")
  // KYC: pendiente hasta que el super-admin aprueba (autoservicio); las que
  // crea el propio super-admin nacen aprobadas. El guard bloquea el resto.
  estadoAprobacion   OrgApprovalStatus   @default(pendiente) @map("estado_aprobacion")
  verificacionDocKey String?             @map("verificacion_doc_key")
  motivoRechazo      String?             @map("motivo_rechazo")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  plan               Plan?               @relation(fields: [planId], references: [id])
  memberships        Membership[]
  clientProfiles     ClientProfile[]
  invoices           Invoice[]
  subscriptions      Subscription[]
  auditLogs          AuditLog[]
  invitations        Invitation[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  organizationId String         @map("organization_id")
  rol            MembershipRole
  // El contador puede habilitar a un cliente de confianza para VALIDAR facturas
  // (no solo guardarlas). Por defecto, un cliente solo guarda; el contador valida.
  puedeValidar   Boolean        @default(false) @map("puede_validar")
  // El contador habilita a un cliente para ver el resumen de gastos (analítica).
  // Por defecto no lo ve; el contador lo activa por cliente.
  puedeVerReportes Boolean      @default(false) @map("puede_ver_reportes")
  // Usuario de confianza: sus registros manuales NO pasan por el workflow de
  // aprobación aunque la empresa o el cliente lo exijan (excepción por usuario).
  exentoAprobacion Boolean      @default(false) @map("exento_aprobacion")
  createdAt      DateTime       @default(now()) @map("created_at")
  user           User           @relation(fields: [userId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  assignments    Assignment[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model ClientProfile {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  // Contacto principal (legado). Quién puede subir facturas se rige por
  // client_members, que admite varios usuarios por cliente.
  userId         String?      @map("user_id")
  rncOCedula     String       @map("rnc_o_cedula")
  razonSocial    String       @map("razon_social")
  // Política de aprobación de registros manuales de ESTE cliente:
  // heredar (default de la empresa) · siempre · nunca.
  aprobacionManual ManualApprovalPolicy @default(heredar) @map("aprobacion_manual")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])
  assignments    Assignment[]
  members        ClientMember[]
  invoices       Invoice[]
  invitations    Invitation[]

  @@unique([organizationId, rncOCedula])
  @@map("client_profiles")
}

// Usuarios habilitados para subir facturas de un cliente (muchos a muchos).
// Un negocio como CEIDI puede tener varias personas subiendo sus facturas.
model ClientMember {
  clientProfileId String        @map("client_profile_id")
  userId          String        @map("user_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])

  @@id([clientProfileId, userId])
  @@index([userId])
  @@map("client_members")
}

// Qué contador atiende a qué cliente final
model Assignment {
  contadorMembershipId String        @map("contador_membership_id")
  clientProfileId      String        @map("client_profile_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  contadorMembership   Membership    @relation(fields: [contadorMembershipId], references: [id])
  clientProfile        ClientProfile @relation(fields: [clientProfileId], references: [id])

  @@id([contadorMembershipId, clientProfileId])
  @@map("assignments")
}

model Invoice {
  id                    String        @id @default(uuid())
  organizationId        String        @map("organization_id")
  // Opcional: el contador puede subir sin elegir empresa; se auto-asigna por el
  // RNC del comprador (QR e-CF) o queda "sin asignar" para resolver a mano.
  clientProfileId       String?       @map("client_profile_id")
  // Quién subió la factura (solo lectura, para trazabilidad).
  subidoPorId           String?       @map("subido_por_id")
  estado                InvoiceStatus @default(subida)
  // 'foto' (pipeline OCR) o 'manual' (registrada a mano, con foto opcional).
  origen                String        @default("foto")
  // Página 1 (principal); las páginas adicionales viven en invoice_images.
  // Un comprobante largo (recibo térmico) puede necesitar varias fotos.
  // NULL en registros manuales sin comprobante fotografiado.
  imagenUrl             String?       @map("imagen_url")
  // Hash perceptual de la imagen para detección de duplicados (§4)
  imagenPhash           String?       @map("imagen_phash")
  ncf                   String?
  rncProveedor          String?       @map("rnc_proveedor")
  razonSocialProveedor  String?       @map("razon_social_proveedor")
  fecha                 DateTime?     @db.Date
  montoFacturado        Decimal?      @map("monto_facturado") @db.Decimal(14, 2)
  itbis                 Decimal?      @db.Decimal(14, 2)
  otrosImpuestos        Decimal?      @map("otros_impuestos") @db.Decimal(14, 2)
  propinaLegal          Decimal?      @map("propina_legal") @db.Decimal(14, 2)
  categoria606          String?       @map("categoria_606")
  tipoComprobante       String?       @map("tipo_comprobante")

  // Campos del Formato 606 para el llenado del contador (cols. 1–23)
  tipoIdProveedor       String?       @map("tipo_id_proveedor")       // '1' RNC, '2' cédula (editable, col. 2)
  ncfModificado         String?       @map("ncf_modificado")          // col. 5 (nota crédito/débito)
  fechaPago             DateTime?     @db.Date @map("fecha_pago")      // col. 7
  tipoBienServicio      String?       @map("tipo_bien_servicio")      // 'bienes'|'servicios'|'ambos' (cols. 8/9)
  montoServicios        Decimal?      @map("monto_servicios") @db.Decimal(14, 2)         // col. 8
  montoBienes           Decimal?      @map("monto_bienes") @db.Decimal(14, 2)            // col. 9
  itbisRetenido         Decimal?      @map("itbis_retenido") @db.Decimal(14, 2)          // col. 12
  itbisProporcionalidad Decimal?      @map("itbis_proporcionalidad") @db.Decimal(14, 2)  // col. 13
  itbisCosto            Decimal?      @map("itbis_costo") @db.Decimal(14, 2)             // col. 14
  itbisPercibido        Decimal?      @map("itbis_percibido") @db.Decimal(14, 2)         // col. 16
  tipoRetencionIsr      String?       @map("tipo_retencion_isr")      // col. 17
  montoRetencionRenta   Decimal?      @map("monto_retencion_renta") @db.Decimal(14, 2)   // col. 18
  isrPercibido          Decimal?      @map("isr_percibido") @db.Decimal(14, 2)           // col. 19
  impuestoSelectivo     Decimal?      @map("impuesto_selectivo") @db.Decimal(14, 2)      // col. 20
  formaPago             String?       @map("forma_pago")              // '1'..'7' (col. 23)

  confianzaPorCampo     Json?         @map("confianza_por_campo")
  validacionDgii        Json?         @map("validacion_dgii")
  periodoFiscal         String?       @map("periodo_fiscal") // AAAAMM
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  organization          Organization  @relation(fields: [organizationId], references: [id])
  clientProfile         ClientProfile? @relation(fields: [clientProfileId], references: [id])
  subidoPor             User?         @relation("InvoicesSubidas", fields: [subidoPorId], references: [id])
  categoria             Categoria606? @relation(fields: [categoria606], references: [codigo])
  images                InvoiceImage[]

  // Unicidad fiscal contra duplicados; los NULL no chocan entre sí en PostgreSQL
  @@unique([organizationId, rncProveedor, ncf])
  @@index([organizationId, periodoFiscal])
  @@index([organizationId, estado])
  @@map("invoices")
}

// Páginas adicionales (2+) de una factura larga. La página 1 es invoice.imagenUrl.
model InvoiceImage {
  id         String   @id @default(uuid())
  invoiceId  String   @map("invoice_id")
  key        String // ruta del objeto en MinIO
  orderIndex Int      @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, orderIndex])
  @@map("invoice_images")
}

// Las 11 categorías de gasto del Formato 606 — tabla de referencia, no hardcodear
model Categoria606 {
  codigo   String    @id
  nombre   String
  invoices Invoice[]

  @@map("categorias_606")
}

model Plan {
  id             String         @id @default(uuid())
  nombre         String         @unique
  maxContadores  Int            @map("max_contadores")
  maxClientes    Int            @map("max_clientes")
  maxFacturasMes Int            @map("max_facturas_mes")
  precio         Decimal        @db.Decimal(14, 2)
  createdAt      DateTime       @default(now()) @map("created_at")
  organizations  Organization[]
  subscriptions  Subscription[]

  @@map("plans")
}

model Subscription {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  planId         String             @map("plan_id")
  estado         SubscriptionStatus
  inicio         DateTime
  fin            DateTime?
  metodoPago     String?            @map("metodo_pago")
  createdAt      DateTime           @default(now()) @map("created_at")
  organization   Organization       @relation(fields: [organizationId], references: [id])
  plan           Plan               @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@map("subscriptions")
}

// Crítico para datos fiscales: quién hizo qué y cuándo
model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  userId         String?       @map("user_id")
  accion         String
  entidad        String
  entidadId      String?       @map("entidad_id")
  datos          Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

// Padrón RNC de la DGII (ESPECIFICACION.md §6). Tabla de referencia global
// (no por tenant): se importa en lote desde el archivo público de la DGII y
// permite validar localmente que el RNC del proveedor existe y su razón social
// coincide, antes de generar el 606.
model RncPadron {
  rnc             String   @id
  razonSocial     String   @map("razon_social")
  nombreComercial String?  @map("nombre_comercial")
  actividad       String?
  estado          String?
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("rnc_padron")
}
