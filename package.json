{
  "name": "facturard",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma SaaS multi-tenant para digitalización de facturas y reportes 606/607 ante la DGII (República Dominicana)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @facturard/api dev",
    "dev:worker": "pnpm --filter @facturard/workers dev",
    "db:generate": "pnpm --filter @facturard/shared db:generate",
    "db:migrate": "pnpm --filter @facturard/shared db:migrate",
    "db:deploy": "pnpm --filter @facturard/shared db:deploy",
    "db:seed": "pnpm --filter @facturard/shared db:seed",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
